{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "About · 04 Manufacturing & quality excellence",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "points"],
  "properties": {
    "title": { "type": "string", "maxLength": 120, "x-fieldType": "text" },
    "imageWide": {
      "type": "string", "format": "uuid",
      "x-fieldType": "media", "x-mediaPreset": "wide-16x9", "x-localeInvariant": true
    },
    "imageSquare": {
      "type": "string", "format": "uuid",
      "x-fieldType": "media", "x-mediaPreset": "square", "x-localeInvariant": true
    },
    "points": {
      "type": "array", "minItems": 3, "maxItems": 3, "x-fieldType": "repeatable",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string", "maxLength": 80,  "x-fieldType": "text" },
          "body":  { "type": "string", "maxLength": 300, "x-fieldType": "text" }
        }
      }
    }
  }
}
