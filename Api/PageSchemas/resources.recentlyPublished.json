{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resources · Recently published",
  "description": "mode=auto 時忽略 items，由模板取最新 3 筆（News + Insights 混合）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ],
      "x-fieldType": "enum",
      "x-localeInvariant": true,
      "default": "auto"
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "x-fieldType": "repeatable",
      "x-localeInvariant": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "article"
        ],
        "properties": {
          "article": {
            "type": "string",
            "maxLength": 160,
            "x-fieldType": "ref",
            "x-refEntity": "Article",
            "x-localeInvariant": true
          }
        }
      }
    }
  }
}
