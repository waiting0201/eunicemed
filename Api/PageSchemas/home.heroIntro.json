{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home · Hero 文案",
  "description": "title 內以 **…** 標記高亮字（品牌青）。mockup4 的 hero 沒有 CTA 按鈕。",
  "type": "object",
  "additionalProperties": false,
  "required": ["title"],
  "properties": {
    "eyebrow": { "type": "string", "maxLength": 120, "x-fieldType": "text" },
    "title":   { "type": "string", "maxLength": 200, "x-fieldType": "text" },
    "lead":    { "type": "string", "maxLength": 400, "x-fieldType": "text" }
  }
}
