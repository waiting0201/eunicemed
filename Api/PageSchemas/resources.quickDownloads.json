{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resources · Most requested documents",
  "description": "Download 沒有 slug，ref 的識別字串是 Id（uuid）。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "x-fieldType": "repeatable",
      "x-localeInvariant": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "download"
        ],
        "properties": {
          "download": {
            "type": "string",
            "maxLength": 60,
            "x-fieldType": "ref",
            "x-refEntity": "Download",
            "x-localeInvariant": true
          }
        }
      }
    }
  }
}
