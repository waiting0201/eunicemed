{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "About · 05 Certified, audited, trusted",
  "description": "標章文字取自 Certification 實體，與產品頁共用同一份；此處只存引用。區段標題、導言與 CTA 與版型綁死，寫在前端（docs/15）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array", "minItems": 3, "maxItems": 8, "x-fieldType": "repeatable",
      "x-localeInvariant": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["certification"],
        "properties": {
          "certification": {
            "type": "string", "maxLength": 80,
            "x-fieldType": "ref", "x-refEntity": "Certification", "x-localeInvariant": true
          }
        }
      }
    }
  }
}
