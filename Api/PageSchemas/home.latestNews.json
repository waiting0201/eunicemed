{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home · 05 Latest news",
  "description": "文章由 GET /news?pageSize=3 自動取用；此處只維護區段文案。",
  "type": "object",
  "additionalProperties": false,
  "required": ["title"],
  "properties": {
    "title": { "type": "string", "maxLength": 120, "x-fieldType": "text" },
    "allLink": {
      "type": "object", "additionalProperties": false, "x-fieldType": "link",
      "properties": {
        "label":    { "type": "string", "maxLength": 60, "x-fieldType": "text" },
        "url":      { "type": "string", "maxLength": 400, "x-fieldType": "text", "x-localeInvariant": true },
        "external": { "type": "boolean", "x-fieldType": "bool", "x-localeInvariant": true }
      }
    }
  }
}
