{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resources · 兩塊底部 CTA",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "x-fieldType": "repeatable",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "link"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "x-fieldType": "text"
          },
          "body": {
            "type": "string",
            "maxLength": 300,
            "x-fieldType": "text"
          },
          "ctaLabel": {
            "type": "string",
            "maxLength": 60,
            "x-fieldType": "text"
          },
          "link": {
            "type": "object",
            "additionalProperties": false,
            "x-fieldType": "link",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 60,
                "x-fieldType": "text"
              },
              "url": {
                "type": "string",
                "maxLength": 400,
                "x-fieldType": "text",
                "x-localeInvariant": true
              },
              "external": {
                "type": "boolean",
                "x-fieldType": "bool",
                "x-localeInvariant": true
              }
            }
          }
        }
      }
    }
  }
}
