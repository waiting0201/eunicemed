{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home · 01 Hero products",
  "x-order": 2,
  "description": "產品由 GET /products?featured=true 自動取用（依 FeaturedSortOrder），後台不逐格挑。這裡維護區段標題、引言與全型錄漸層帶。欄位留空時，前台顯示程式碼裡的定稿文字，不會變成空白。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "heading": {
      "type": "string",
      "maxLength": 120,
      "x-fieldType": "text",
      "title": "區段標題"
    },
    "subheading": {
      "type": "string",
      "maxLength": 200,
      "x-fieldType": "text",
      "title": "副標"
    },
    "intro": {
      "type": "string",
      "maxLength": 600,
      "x-fieldType": "text",
      "title": "引言"
    },
    "promo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": {
          "type": "string",
          "maxLength": 80,
          "x-fieldType": "text"
        },
        "title": {
          "type": "string",
          "maxLength": 160,
          "x-fieldType": "text"
        },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "x-fieldType": "link",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 60,
              "x-fieldType": "text"
            },
            "url": {
              "type": "string",
              "maxLength": 400,
              "x-fieldType": "text",
              "x-localeInvariant": true
            },
            "external": {
              "type": "boolean",
              "x-fieldType": "bool",
              "x-localeInvariant": true
            }
          }
        }
      }
    }
  }
}
