{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home · 01 Hero products",
  "description": "產品由 GET /products?featured=true 自動取用（依 FeaturedSortOrder），後台不逐格挑。區段標題與版型綁死，寫在前端；此處只維護全型錄漸層帶的檔期文案。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "promo": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "eyebrow": { "type": "string", "maxLength": 80, "x-fieldType": "text" },
        "title":   { "type": "string", "maxLength": 160, "x-fieldType": "text" },
        "link": {
          "type": "object", "additionalProperties": false, "x-fieldType": "link",
          "properties": {
            "label":    { "type": "string", "maxLength": 60, "x-fieldType": "text" },
            "url":      { "type": "string", "maxLength": 400, "x-fieldType": "text", "x-localeInvariant": true },
            "external": { "type": "boolean", "x-fieldType": "bool", "x-localeInvariant": true }
          }
        }
      }
    }
  }
}
